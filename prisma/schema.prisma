generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  PAYPAL
}

enum PaymentEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  MISMATCHED
  MISSING_IN_PROVIDER
  MISSING_IN_LEDGER
}

model PaymentEvent {
  id              String             @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  transactionRef  String
  amount          Int
  currency        String             @default("GBP")
  customerEmail   String?
  status          PaymentEventStatus @default(RECEIVED)
  rawPayload      Json

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  ledgerEntries   LedgerEntry[]

  @@unique([provider, providerEventId])
  @@index([transactionRef])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  actor      String?
  metadata   Json?

  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([action])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  paymentEventId String
  entryType      LedgerEntryType
  account        String
  amount         Int
  currency       String          @default("GBP")
  description    String

  createdAt      DateTime        @default(now())

  paymentEvent   PaymentEvent    @relation(fields: [paymentEventId], references: [id])

  @@index([paymentEventId])
  @@index([account])
}

model SettlementRecord {
  id                    String               @id @default(uuid())
  provider              PaymentProvider
  providerTransactionId String
  transactionRef         String
  amount                Int
  currency              String               @default("GBP")
  settledAt             DateTime
  reconciliationStatus  ReconciliationStatus @default(PENDING)
  mismatchReason        String?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([transactionRef])
  @@unique([provider, providerTransactionId])
}